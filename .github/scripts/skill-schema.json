{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SuperClawd Skill",
  "description": "Schema for SuperClawd community skill files. A skill is authored in one of two formats: 'structured' (a tree of categories/instructions) or 'markdown' (a free-form markdown body).",
  "type": "object",
  "required": ["name", "action", "executionMode", "description"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "The skill name"
    },
    "action": {
      "type": "string",
      "enum": [
        "analyze",
        "plan",
        "design",
        "code",
        "test",
        "review",
        "debug",
        "commit",
        "deploy",
        "write",
        "behave"
      ],
      "description": "The action type this skill applies to"
    },
    "executionMode": {
      "type": "string",
      "enum": ["auto", "always"],
      "description": "When the skill should be executed"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250,
      "description": "Brief description of the skill"
    },
    "format": {
      "type": "string",
      "enum": ["structured", "markdown"],
      "description": "Authoring format. Defaults to 'structured' when omitted (backward compatible)."
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/definitions/category"
      },
      "description": "Instruction categories (structured skills only)"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "description": "Free-form markdown body (markdown skills only)"
    },
    "character_count": {
      "type": "integer",
      "description": "Optional precomputed character count for markdown skills (ignored on import)"
    },
    "token_count": {
      "type": "integer",
      "description": "Optional precomputed token count for markdown skills (ignored on import)"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "title": "Structured skill",
      "description": "Has categories; format is 'structured' or omitted.",
      "properties": {
        "format": { "const": "structured" }
      },
      "required": ["categories"],
      "not": { "required": ["body"] }
    },
    {
      "title": "Markdown skill",
      "description": "Has a markdown body; format must be 'markdown'.",
      "properties": {
        "format": { "const": "markdown" }
      },
      "required": ["format", "body"],
      "not": { "required": ["categories"] }
    }
  ],
  "definitions": {
    "category": {
      "type": "object",
      "required": ["name", "instructions"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Category name"
        },
        "description": {
          "type": "string",
          "maxLength": 100,
          "description": "Category description"
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/instruction"
          },
          "description": "Instructions in this category"
        }
      },
      "additionalProperties": false
    },
    "instruction": {
      "type": "object",
      "required": ["content", "type"],
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "The instruction content"
        },
        "type": {
          "type": "string",
          "enum": ["direct", "conditional"],
          "description": "Instruction type"
        },
        "subInstructions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": "Sub-instructions for conditional type"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "type": { "const": "conditional" }
        }
      },
      "then": {
        "required": ["subInstructions"]
      }
    }
  }
}
